# i-dream — environment variables (the FULL list, all 2 of them)
#
# Copy to one of:
#   1. ~/.claude/subconscious/.env   ← canonical (loaded by the daemon under launchd)
#   2. ./.env                         ← repo-local (loaded during `cargo run`)
#
# Both are loaded silently via dotenvy in this order; (1) overrides (2).
#
# IMPORTANT: this file is intentionally tiny. Almost every i-dream
# behavior is configured via ~/.claude/subconscious/config.toml — NOT
# via env vars. See:
#   - docs/12-config-reference.md  → full schema walkthrough + defaults
#   - config.toml.example          → copyable starting point with every
#                                     section documented
# Run `i-dream config` to dump the current effective config.

# ─────────────────────────────────────────────────────────────────────
#  ANTHROPIC_API_KEY
# ─────────────────────────────────────────────────────────────────────
# Required ONLY in direct API mode (i.e. config.toml has
# [budget] use_claude_code_cli = false). Get one at
# https://console.anthropic.com/settings/keys.
#
# In the default subprocess mode (use_claude_code_cli = true), i-dream
# calls the local `claude` CLI which authenticates via your Pro/Max
# subscription and does NOT need this key. See docs/09-cli-vs-api.md.
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────
#  RUST_LOG
# ─────────────────────────────────────────────────────────────────────
# tracing-subscriber filter. Overrides [daemon] log_level in config.toml
# at runtime. Default: info.
# Examples: "debug", "i_dream=debug,reqwest=warn", "warn"
RUST_LOG=info
