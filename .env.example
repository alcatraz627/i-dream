# i-dream — environment variables
#
# Copy to one of:
#   1. ~/.claude/subconscious/.env   ← canonical (loaded by the daemon under launchd)
#   2. ./.env                         ← repo-local (loaded during `cargo run`)
#
# Both are loaded silently via dotenvy in this order; (1) overrides (2).
# Anything you don't set falls through to a sensible default in src/config.rs.

# ─────────────────────────────────────────────────────────────────────
#  Claude API access
# ─────────────────────────────────────────────────────────────────────

# Required ONLY if you set [budget] use_claude_code_cli = false in
# config.toml (i.e. direct Anthropic API mode). Get one at
# https://console.anthropic.com/settings/keys.
#
# In the default subprocess mode, i-dream calls the local `claude` CLI
# instead of the API directly — that re-uses your Pro/Max subscription
# and does NOT need this key. See docs/09-cli-vs-api.md for tradeoffs.
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────
#  Logging
# ─────────────────────────────────────────────────────────────────────

# tracing-subscriber filter. Default: info.
# Examples: "debug", "i_dream=debug,reqwest=warn", "warn"
RUST_LOG=info

# ─────────────────────────────────────────────────────────────────────
#  Notes
# ─────────────────────────────────────────────────────────────────────
#
# Most i-dream behavior is controlled via config.toml at
# ~/.claude/subconscious/config.toml — NOT env vars. Run
# `i-dream config` to dump the current config, or browse
# the keys in src/config.rs::Config.
#
# Config sections:
#   [limits]      — per-cycle token / runtime caps
#   [ingestion]   — Claude Code projects/ scan settings
#   [daemon]      — socket path, PID file, idle activity signal
#   [idle]        — hours_between_cycles + check_interval_minutes
#   [budget]      — model selection + use_claude_code_cli flag
#   [modules]     — per-module enables and tunables (dreaming/metacog/
#                   intuition/introspection/prospective/briefing)
#   [hooks]       — which Claude Code hooks to install
#
# Override budget.model via env? No — it's a TOML field. Edit the file
# directly via `i-dream config-edit` (or just `nvim` it).
