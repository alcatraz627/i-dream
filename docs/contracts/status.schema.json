{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "i-dream status --json",
  "description": "The summary contract the widget reads. Every top-level section is named in `sources` with the file or command it comes from.",
  "type": "object",
  "required": ["daemon", "lanes", "queue", "modules", "jobs", "reader", "domains", "interventions", "reflect", "sources"],
  "properties": {
    "daemon": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"type": "string"}, "pid": {"type": "integer"}}
    },
    "lanes": {
      "type": "object",
      "required": ["green", "yellow", "red", "lanes"],
      "properties": {
        "lanes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["lane", "status", "reason", "consumer", "consumer_state"]
          }
        }
      }
    },
    "queue": {"type": "object", "required": ["depth"]},
    "modules": {"type": "array"},
    "jobs": {
      "type": "array",
      "items": {"type": "object", "required": ["label", "schedule", "installed", "loaded"]}
    },
    "reader": {
      "type": "object",
      "required": ["last_recon", "last_weekly", "clusters", "awaiting", "latest_items", "landed"]
    },
    "domains": {
      "type": "array",
      "items": {"type": "object", "required": ["name", "events_in_window"]}
    },
    "interventions": {
      "type": "object",
      "required": ["live", "candidate", "shadow", "fired_7d"]
    },
    "reflect": {
      "type": "array",
      "items": {"type": "object", "required": ["slug", "severity", "total", "last7", "prior7", "delta7"]}
    },
    "sources": {"type": "object"}
  }
}
