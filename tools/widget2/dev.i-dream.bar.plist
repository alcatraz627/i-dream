<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install.sh replaces __HOME__ with the owner's home directory,
     because launchd does not expand ~ in ProgramArguments. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.i-dream.bar</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Applications/i-dream-bar.app/Contents/MacOS/i-dream-bar</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
  </dict>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/i-dream-bar/i-dream-bar.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/i-dream-bar/i-dream-bar.log</string>
</dict>
</plist>
